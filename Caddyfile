# Automatic HTTPS for geist-app.com.
# Caddy obtains and renews Let's Encrypt certificates automatically.
# Requires: DNS A/AAAA records for geist-app.com (and www) pointing at the VPS,
# and ports 80 + 443 open in the Strato firewall.
geist-app.com, www.geist-app.com {
	encode gzip
	reverse_proxy frontend:80
}
